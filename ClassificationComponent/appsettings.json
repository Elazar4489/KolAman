{
  
    "Serilog": {
      "Using": [ "Serilog.Sinks.Console", "Elastic.Serilog.Sinks" ],
      "MinimumLevel": "Information",
      "WriteTo": [
        { "Name": "Console" },
        {
          "Name": "Elasticsearch",
          "Args": {
            "nodes": [ "http://localhost:9200" ],
            "dataStream": "logs-classification"
          }
        }
      ]
    },



  "Redis": {
    "EndPoints": { "localhost":"6379" },
    "User": "yourUsername",
    "Password": "yourPassword"
  },

  "Kafka": {
    "BootstrapServers": "localhost:9094",
    "GroupId": "classification-group",
    "AutoOffsetReset": "Earliest",
    "EnableAutoCommit": false,
    "Topic": "notifications"
  },
  "RabbitMQ": {
    "Host": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "Username": "guest",
    "Password": "guest",
    "ExchangeName": "commands",
    "ExchangeType": "direct",
    "CentralCommand": "alert.central.command",
    "RoutingKeyCentral": "central.command",
    "SouthernCommand": "alert.southern.command",
    "RoutingKeySouthern": "southern.command",
    "NorthernCommand": "alert.northern.command",
    "RoutingKeyNorthern": "northern.command",
    "DeepCommand": "alert.deep.command",
    "RoutingKeyDeep": "deep.command"
  }
}
